{
  "id": "screenkey",
  "name": "Screenkey",
  "icon": "keyboard",
  "description": "Displays keystrokes on screen in a readable format for tutorials",
  "version": "1.2.0",
  "author": "Loc Huynh",
  "type": "composite",
  "capabilities": [
    "daemon",
    "control-center"
  ],
  "components": {
    "daemon": "./ScreenkeyDaemon.qml",
    "widget": "./ScreenkeyWidget.qml"
  },
  "settings": "./ScreenkeySettings.qml",
  "requires_dms": ">=2.0.0",
  "dependencies": [
    "python3"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "shell_execute"
  ]
}
