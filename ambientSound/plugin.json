{
  "id": "ambientSound",
  "name": "Ambient Sounds",
  "description": "Play ambient sounds for focus",
  "version": "2.6.2",
  "requires_dms": ">=2.0.0",
  "license": "GPL-3.0",
  "author": "Loc Huynh",
  "icon": "music_note",
  "type": "composite",
  "capabilities": [
    "dankbar-widget",
    "dash-tab",
    "dash-card"
  ],
  "components": {
    "widget": "./AmbientWidget.qml",
    "dash": "./DashTab.qml",
    "dashCard": "./DashCard.qml"
  },
  "dash": {
    "title": "Ambient Sounds",
    "card": {
      "title": "Ambient Sounds",
      "w": 2,
      "h": 1,
      "minW": 1,
      "minH": 1,
      "maxW": 4,
      "maxH": 2
    },
    "options": [
      {
        "key": "compact",
        "text": "Compact layout",
        "type": "toggle",
        "def": false
      }
    ]
  },
  "settings": "./AmbientSettings.qml",
  "permissions": [
    "settings_read",
    "settings_write"
  ]
}
