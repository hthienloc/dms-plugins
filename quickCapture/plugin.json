{
  "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
  "id": "quickCapture",
  "name": "Quick Capture",
  "description": "Screenshot annotation and screen recording tool",
  "version": "5.10.0",
  "author": "Loc Huynh",
  "icon": "screenshot_region",
  "type": "composite",
  "capabilities": [
    "daemon",
    "control-center",
    "dankbar-widget",
    "dash-card"
  ],
  "components": {
    "daemon": "./QuickCaptureDaemon.qml",
    "widget": "./QuickCaptureWidget.qml",
    "dashCard": "./QuickCaptureCard.qml"
  },
  "dash": {
    "card": {
      "title": "Quick Capture",
      "w": 2,
      "h": 1,
      "minW": 1,
      "minH": 1,
      "maxW": 4,
      "maxH": 2
    },
    "options": [
      {
        "key": "tone",
        "text": "Tone",
        "type": "choice",
        "def": "",
        "choices": [
          {
            "value": "",
            "text": "Surface"
          },
          {
            "value": "primary",
            "text": "Primary"
          },
          {
            "value": "secondary",
            "text": "Secondary"
          },
          {
            "value": "tertiary",
            "text": "Tertiary"
          }
        ]
      }
    ]
  },
  "settings": "./QuickCaptureSettings.qml",
  "requires_dms": ">=2.0.0",
  "dependencies": [
    "gpu-screen-recorder",
    "wf-recorder",
    "ffmpeg",
    "magick",
    "img2pdf",
    "tesseract",
    "zbarimg"
  ],
  "permissions": [
    "settings_read",
    "settings_write",
    "shell_execute"
  ]
}
